# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=IDS-IIoT-SCADA

# Backblaze B2 - S3 compatible (vraies valeurs dans .env, JAMAIS ici)
AWS_ACCESS_KEY_ID=votre_keyID_backblaze
AWS_SECRET_ACCESS_KEY=votre_applicationKey_backblaze
MLFLOW_S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com

# Bucket Backblaze (artefacts MLflow)
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

MODEL_PATH=models/model.pkl
FEATURES_PATH=models/features.json
PROD_LOG_PATH=data/production/requests.csv

# Code d'erreur de validation de l'API : 422 (starter kit) ou 400 (cahier des charges)
VALIDATION_STATUS=422

